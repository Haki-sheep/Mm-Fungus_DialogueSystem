  title: "\u57CE\u95E8\u901A\u884C"
  entry: welcome
  sourceJson: "{\r\n  \"version\": 1,\r\n  \"id\": \"gate_sample\",\r\n  \"title\":
    \"\u57CE\u95E8\u901A\u884C\",\r\n  \"entry\": \"welcome\",\r\n  \"variables\":
    [{ \"key\": \"trust\", \"title\": \"\u5B88\u536B\u4FE1\u4EFB\", \"type\": \"Integer\",
    \"value\": \"0\" }],\r\n  \"nodes\": [\r\n    { \"id\": \"welcome\", \"title\":
    \"\u5B88\u536B\u95EE\u8BDD\", \"type\": \"say\", \"x\": 0, \"y\": 0, \"text\":
    \"\u57CE\u95E8\u5C31\u8981\u5173\u95ED\u4E86\u3002\u4F60\u6765\u8FD9\u91CC\u6709\u4EC0\u4E48\u4E8B\uFF1F\",
    \"actor\": \"speaker\", \"next\": \"answer\" },\r\n    { \"id\": \"answer\",
    \"title\": \"\u73A9\u5BB6\u9009\u62E9\", \"type\": \"choice\", \"x\": 280, \"y\":
    0, \"options\": [ { \"text\": \"\u6211\u662F\u6765\u9001\u4FE1\u7684\u3002\",
    \"target\": \"trust_guard\" }, { \"text\": \"\u53EA\u662F\u8DEF\u8FC7\uFF0C\u660E\u5929\u518D\u6765\u5427\u3002\",
    \"target\": \"check\" } ] },\r\n    { \"id\": \"trust_guard\", \"title\": \"\u589E\u52A0\u4FE1\u4EFB\",
    \"type\": \"set\", \"x\": 560, \"y\": 0, \"variable\": \"trust\", \"operation\":
    \"add\", \"value\": \"1\", \"next\": \"check\" },\r\n    { \"id\": \"check\",
    \"title\": \"\u5224\u65AD\u4FE1\u4EFB\", \"type\": \"condition\", \"x\": 840,
    \"y\": 0, \"variable\": \"trust\", \"comparison\": \"gte\", \"value\": \"1\",
    \"onTrue\": \"permit\", \"onFalse\": \"leave\" },\r\n    { \"id\": \"permit\",
    \"title\": \"\u5141\u8BB8\u901A\u884C\", \"type\": \"event\", \"x\": 1120, \"y\":
    0, \"eventMode\": \"signal\", \"eventId\": \"gate_opened\", \"eventTitle\": \"\u5141\u8BB8\u901A\u884C\",
    \"eventValueKind\": \"Integer\", \"value\": \"1\", \"next\": \"pause\" },\r\n   
    { \"id\": \"pause\", \"title\": \"\u5F00\u95E8\u7B49\u5F85\", \"type\": \"wait\",
    \"x\": 1400, \"y\": 0, \"seconds\": 0.2, \"next\": \"enter\" },\r\n    { \"id\":
    \"enter\", \"title\": \"\u6B22\u8FCE\u5165\u57CE\", \"type\": \"say\", \"x\":
    1680, \"y\": 0, \"text\": \"\u539F\u6765\u662F\u4FE1\u4F7F\u3002\u8BF7\u8FDB\uFF0C\u65C5\u5E97\u5C31\u5728\u57CE\u95E8\u53F3\u4FA7\u3002\\n\u5F53\u524D\u4FE1\u4EFB\uFF1A{$trust}\",
    \"actor\": \"speaker\", \"next\": \"end\" },\r\n    { \"id\": \"leave\", \"title\":
    \"\u660E\u65E5\u518D\u6765\", \"type\": \"say\", \"x\": 1120, \"y\": 260, \"text\":
    \"\u597D\uFF0C\u8DEF\u4E0A\u5C0F\u5FC3\u3002\u660E\u5929\u65E9\u4E0A\u518D\u6765\u5427\u3002\",
    \"actor\": \"speaker\", \"next\": \"end\" },\r\n    { \"id\": \"end\", \"title\":
    \"\u7ED3\u675F\", \"type\": \"end\", \"x\": 1960, \"y\": 0 }\r\n  ]\r\n}\r\n"
